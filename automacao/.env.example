# Copie para .env e preencha. NUNCA envie o .env para o GitHub.
# Para gerar uma senha aleatória: openssl rand -hex 24

# Endereço do ERP (Railway) e o mesmo token definido lá em ERP_INTEGRACAO_TOKEN
ERP_URL=https://seu-erp.up.railway.app
ERP_INTEGRACAO_TOKEN=troque-por-um-token-aleatorio

# Chave mestra do Evolution API (é a senha do painel /manager)
EVOLUTION_APIKEY=troque-por-uma-chave-aleatoria
# Endereço público do Evolution API (no computador: http://localhost:8080)
EVOLUTION_URL_PUBLICA=http://localhost:8080

# Senha que o Evolution manda ao n8n em cada mensagem (protege o webhook)
WEBHOOK_TOKEN=troque-por-outro-token-aleatorio

# Senha do banco do Evolution
POSTGRES_SENHA=troque-por-uma-senha-aleatoria

# Endereço do n8n. Num servidor com HTTPS: N8N_URL=https://n8n.seudominio.com.br e N8N_SECURE_COOKIE=true
N8N_HOST=localhost
N8N_URL=http://localhost:5678
N8N_SECURE_COOKIE=false

# Resposta automática para quem chama pela primeira vez. {nome} vira o nome do contato.
# Deixe vazio para usar a mensagem padrão do fluxo.
MENSAGEM_BOAS_VINDAS=
